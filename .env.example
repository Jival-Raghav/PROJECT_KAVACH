# ── LLM Providers ─────────────────────────────────────────────────────────────
# Options: groq | lmstudio | ollama | none
PROSECUTOR_PROVIDER=groq
DA_PROVIDER=groq
ADJUDICATOR_PROVIDER=groq
MAPPER_PROVIDER=groq
GUARD_PROVIDER=groq

# ── Local Models (LM Studio / Ollama) ─────────────────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# ── Cloud LLMs ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Replay guardrail ───────────────────────────────────────────
LLM_REPLAY_ONLY=0


# ── Kill chain ────────────────────────────────────────────────────────────────
# Path to the FortiGate log (default: REAL_10G_DATA/firex-10G.log)
# KILLCHAIN_LOG_PATH=C:/path/to/firex-10G.log
# Results folder the app shows and writes (default: firex)
# KILLCHAIN_RUN_ID=firex
# DuckDB memory cap and log-reading processes
# KILLCHAIN_DUCKDB_MEMORY=7GB
# KILLCHAIN_INGEST_WORKERS=6
